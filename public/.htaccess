<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force non-www (redirect www -> bare domain)
    RewriteCond %{HTTP_HOST} ^www\.nestednurturers\.com$ [NC]
    RewriteRule ^(.*)$ https://nestednurturers.com/$1 [L,R=301]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # If request is already for /public, stop
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # If file or folder exists, serve normally
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Otherwise send everything to Laravel
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>